#!/usr/bin/env python3
# Deskmate's command line: ./deskmate setup, doctor, up, down, open, update, uninstall, config, connect, habits.
# This file stays readable by old Pythons (no f-strings) so that it can say which Python is needed;
# everything else lives in setup/deskmate_setup and needs Python 3.9 or newer, standard library only.
import os
import sys

MIN = (3, 9)


def main():
    if sys.version_info < MIN:
        sys.stderr.write("Deskmate's setup needs Python %d.%d or newer; this is %s.\n"
                         "On macOS: xcode-select --install. On Linux: install python3 from your package manager.\n"
                         % (MIN[0], MIN[1], sys.version.split()[0]))
        return 3
    if os.name == "nt":
        sys.stderr.write("On Windows, Deskmate runs inside WSL 2: wsl --install, open the Linux distro, clone Deskmate "
                         "there (not under /mnt/c) and run ./deskmate setup.\n")
        return 3
    if os.geteuid() == 0:
        sys.stderr.write("Don't run Deskmate as root or with sudo: it sets things up for your own user (your Claude Code, "
                         "your folders). Run it as yourself. If Docker needs sudo, add yourself to the docker group: "
                         "sudo usermod -aG docker $USER, then log out and in again.\n")
        return 3
    here = os.path.dirname(os.path.realpath(__file__))
    sys.path.insert(0, os.path.join(here, "setup"))
    from deskmate_setup import cli

    return cli.main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
