# Deskmate settings. You don't need to copy this file: ./deskmate setup writes .env for you (mode 0600),
# with every value detected or chosen in the wizard, and ./deskmate config set KEY VALUE changes one.
# This file documents every key. Lists use ':' like PATH. Values are quoted only when they contain spaces.
#
# No secrets in .env, ever. The hub token, the secretary's Claude login and the webhook URL are files in
# $DESKMATE_DATA_DIR/secrets (0600), mounted into the hub with Compose `secrets:`. Set them with
#   ./deskmate config set-secret claude-token     (paste the output of `claude setup-token`)
#   ./deskmate config set-secret notify-url       (a Discord or Slack webhook, an ntfy topic URL, any webhook)
#   ./deskmate config set-secret hub-token        (empty input makes a new one; sign in again afterwards)
# For a non-interactive setup (./deskmate setup --answers FILE), secrets come from the environment
# (CLAUDE_CODE_OAUTH_TOKEN, NOTIFY_WEBHOOK_URL) or from files (CLAUDE_CODE_OAUTH_TOKEN_FILE, NOTIFY_WEBHOOK_FILE).

# ---- You

# Your name, as agents and notifications use it. Default: the first word of `git config user.name`, else your login.
DESKMATE_OWNER=Alex

# Time zone (IANA name) for the desk's clock, the daily brief and the morning post. Default: this computer's.
TZ=Europe/London

# ---- This computer

# Deskmate's data: the secretary's database (hub/), files exchanged with the desk (exchange/), the secret files
# (secrets/). Mode 0700. A full path without spaces, not on a Windows drive (/mnt/c).
# Default: ${XDG_DATA_HOME:-$HOME/.local/share}/deskmate
DESKMATE_DATA_DIR=/home/alex/.local/share/deskmate

# Your home folder, shown as ~ in Deskmate's page. Default: $HOME.
HOST_HOME=/home/alex

# Your user and group id: the hub runs as you, so the files it writes are yours. Default: id -u / id -g.
HOST_UID=1000
HOST_GID=1000

# Docker Compose project: names the containers and the desk's volumes (its browser logins live there).
# Default: deskmate; deskmate-<user> when another user's Deskmate already runs on this Docker.
COMPOSE_PROJECT_NAME=deskmate

# Compose files: the shared one, the network mode (from DESK_NETWORK) and the generated mounts.
# Written by setup from DESK_NETWORK; don't edit them by hand.
COMPOSE_FILE=compose.yaml:deploy/net-host.yaml:compose.local.yaml
COMPOSE_PATH_SEPARATOR=:

# ---- The desk

# What the desk's browser can open:
#   host         this computer's localhost and the internet (Linux Docker Engine; the default there)
#   host-access  your machine's localhost through host.docker.internal (Docker Desktop on macOS, Windows, Linux,
#                and rootless Docker before 29.5)
#   isolated     the internet only
DESK_NETWORK=host

# Port of Deskmate's page, MCP server and hooks, on 127.0.0.1 only. Default: 7800, else the next free one.
HUB_PORT=7800

# Chromium's DevTools port in host networking, on 127.0.0.1 only. Default: 7802, else the next free one.
CDP_PORT=7802

# The desk's X display number. In host networking it must be free on this computer. Default: 87, else the next free.
DESK_DISPLAY=87

# How many monitors the desk has (1-4), and the size of each: 1280x800, 1440x900, 1600x900 or 1920x1080.
DESK_MONITORS=2
DESK_MONITOR_SIZE=1280x800

# ---- What the secretary may read (all read-only)

# Claude Code config folders. Only <folder>/projects is mounted, never the folder itself (it holds your login).
# Default: $CLAUDE_CONFIG_DIR or ~/.claude, plus any folder a shell profile points CLAUDE_CONFIG_DIR at.
CLAUDE_CONFIG_DIRS=/home/alex/.claude

# The secretary reads sessions started in these folders or below. Found from each session's working folder.
SESSIONS_ROOTS=/home/alex/work

# Optional docs hub (a folder with changelog/README.md or design/_template.md). Empty: none.
DOCS_DIR=

# Claude Code's memory notes for those folders, and the git history of the repos in them: on or off.
READ_MEMORY=on
READ_GIT=on

# ---- The secretary

# Session digests, the daily brief and Ask: on or off. The desk and its tools work either way.
SECRETARY=on

# Models: digests run once per finished session, the brief once a day, Ask when you ask.
SECRETARY_DIGEST_MODEL=claude-haiku-4-5-20251001
SECRETARY_BRIEF_MODEL=claude-sonnet-5-5
SECRETARY_ASK_MODEL=claude-sonnet-5-5

# Pause digests when your 5-hour window is this full (0-1), and at most this many digests a day.
SECRETARY_PAUSE_AT=0.60
SECRETARY_MAX_DIGESTS_PER_DAY=40

# Daily brief time, and the morning post of yesterday's brief (only with notifications on). HH:MM local time.
BRIEF_AT=18:30
MORNING_POST_AT=09:00

# ---- Notifications

# Where notifications go: none, discord, slack, ntfy or webhook. Setup tells it from the URL.
NOTIFY_KIND=none

# The file holding the webhook URL, mounted read-only. Default: $DESKMATE_DATA_DIR/secrets/notify-url.
# Point it at a file you already have and Deskmate mounts it, never copying it.
NOTIFY_URL_FILE=/home/alex/.local/share/deskmate/secrets/notify-url

# ---- Working habits

# The working-habits pack (rules in CLAUDE.md, changelog and design-doc skills, an end-of-turn check): on or off.
# Its folders and choices live in ${XDG_CONFIG_HOME:-~/.config}/deskmate/habits.json (./deskmate habits status).
HABITS=off
