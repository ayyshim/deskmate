# Copy to .env (make env does it and fills in the token). Never commit .env.

# Bearer token for /mcp and /hooks, and the sign-in link for the web UI. `make env` generates it.
DESKMATE_TOKEN=

# The secretary's Claude login: run `claude setup-token` and paste the token here.
# Without it, everything except the model calls (digests, brief, Ask) still works.
CLAUDE_CODE_OAUTH_TOKEN=

# Your uid/gid, so files the hub writes on this machine belong to you. `make env` fills them in.
HOST_UID=1000
HOST_GID=1000

# Which sessions the secretary reads: project folders in ~/.claude/projects whose name starts
# with this (D9: only sessions started in ~/Projects).
SESSIONS_PREFIX=-home-ashim-Projects

# Usage guard: the secretary pauses model calls when the 5-hour window is at least this full.
SECRETARY_PAUSE_AT=0.60
SECRETARY_MAX_DIGESTS_PER_DAY=40
SECRETARY_DIGEST_MODEL=claude-haiku-4-5-20251001
SECRETARY_BRIEF_MODEL=claude-sonnet-5-5

# Local times (this machine's timezone) for the daily brief and the morning Discord post.
TZ=Asia/Kathmandu
BRIEF_AT=18:30
DISCORD_BRIEF_AT=09:00
